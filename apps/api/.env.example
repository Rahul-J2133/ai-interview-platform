# ─────────────────────────────────────────────────────────────
# apps/api — Environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/interview_db

# Groq API key (LLM inference)
GROQ_API_KEY=gsk_...

# Clerk auth domain (e.g. proud-lynx-42.clerk.accounts.dev)
CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev

# Clerk webhook signing secret (from Clerk dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# ── Optional — server ─────────────────────────────────────────

PORT=4000
NODE_ENV=development        # development | production | test
LOG_LEVEL=info              # trace | debug | info | warn | error
WEB_URL=http://localhost:3000

# ── Optional — Redis ─────────────────────────────────────────
#
# Required for multi-process / multi-instance deployments.
# When set, SSE events are routed via Redis pub/sub so a POST /message
# hitting instance A can push the AI response to the client connected
# on instance B.
#
# Also enables distributed rate limiting (MemoryRateLimitStore is
# replaced by RedisRateLimitStore when this is set).
#
# Recommended: Upstash Redis (serverless, free tier available)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:token@your-upstash-endpoint:6379

# ── Optional — DB pool ────────────────────────────────────────
#
# Number of Postgres connections per process.
# Rule of thumb: floor(db_max_connections / num_processes) - margin
#
# Neon/RDS free tier (25 max), 1 process:  DB_POOL_MAX=20
# Neon/RDS free tier (25 max), 2 processes: DB_POOL_MAX=10
# Standard tier (100 max), 4 processes:    DB_POOL_MAX=20
#
# DB_POOL_MAX=5

# ── Optional — timeouts ───────────────────────────────────────

# Max time (ms) to wait for an AI response before emitting an error SSE
# RESPONSE_TIMEOUT_MS=45000

# Max time (ms) to wait for session initialization (plan generation)
# SESSION_INIT_TIMEOUT_MS=30000

# ── Optional — observability ─────────────────────────────────

# Sentry DSN — leave empty to disable Sentry
# SENTRY_DSN=https://...@sentry.io/...

# Secret header value for GET /internal/health
# Set to a long random string; leave empty to allow unauthenticated access
# (only do this on a private network)
# INTERNAL_SECRET=a-long-random-string-here
