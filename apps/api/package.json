{
  "name": "@interview/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:sourcemaps": "tsc -p tsconfig.json && sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload dist",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@hono/zod-validator": "^0.2.2",
    "@interview/ai-engine": "*",
    "@interview/shared-types": "*",
    "@interview/state-machines": "*",
    "@interview/doc-parser": "*",
    "@sentry/node": "^8.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.31.0",
    "hono": "^4.4.0",
    "groq-sdk": "^1.1.2",
    "postgres": "^3.4.0",
    "redis": "^4.7.0",
    "svix": "^1.21.0",
    "uuid": "^10.0.0",
    "xstate": "^5.14.0",
    "zod": "^3.23.0",
    "pdf-parse": "^2.4.5",
    "mammoth": "^1.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0"
  },
  "devDependencies": {
    "@sentry/cli": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.23.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  }
}