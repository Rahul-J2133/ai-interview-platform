# ============================================================
# Copy this file to apps/api/.env and fill in real values.
# The API reads ONLY from apps/api/.env (or the monorepo root
# .env as a fallback when running via turbo from the root).
# ============================================================

# ── POSTGRES ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/interview_platform"

# ── GROQ (replaces Anthropic) ─────────────────────────────
# Get your key from https://console.groq.com
GROQ_API_KEY="gsk_..."

# ── CLERK ─────────────────────────────────────────────────
# Your Clerk app domain — find it in Clerk Dashboard → API Keys
CLERK_DOMAIN="your-app.clerk.accounts.dev"

# Webhook signing secret — Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET="whsec_..."

# ── SERVER ────────────────────────────────────────────────
PORT=4000
# WebSocket server listens on PORT+1 (4001)

WEB_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"
